<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.mybatis01helloworld.mapper.OrderMapper">
    <resultMap id="OrderRM" type="com.example.mybatis01helloworld.bean.Order">
        <id property="id" column="id"/>
        <result property="address" column="address"/>
       <result property="amount" column="amount"/>
        <result column="customer_id" property="customerId"></result>
        <!--一对一关联-->
        <association property="customer"
                     javaType="com.example.mybatis01helloworld.bean.Customer">
            <id property="id" column="c_id"/>
            <result property="customerName" column="customer_name"/>
            <result property="phone" column="phone"/>
        </association>

    </resultMap>
    <select id="getOrderByIdWithCustomer" resultMap="OrderRM">
        select o.*,c.id c_id ,c.customer_name,c.phone  from t_order o left join t_customer c
        on o.customer_id = c.id where o.id = #{id}
    </select>
</mapper>